{
  "name": "@streammagpie/app",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "StreamMagpie desktop app (Electron). Product version lives here.",
  "author": "StreamMagpie",
  "productName": "StreamMagpie",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "vite build -c electron.main.config.ts",
    "build:preload": "vite build -c electron.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --dir",
    "dist:dmg": "npm run build && electron-builder"
  },
  "dependencies": {
    "@streammagpie/engine": "*"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.6"
  }
}
